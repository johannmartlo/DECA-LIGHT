# DECA Light — Variables de entorno de ejemplo
# Copiar este archivo a .env para desarrollo local. NUNCA subir .env al repositorio.

# Entorno de la aplicación
APP_ENV=development
APP_NAME="DECA Light"
APP_VERSION="0.1.0"
DEBUG=true

# Servidor web
APP_HOST=0.0.0.0
APP_PORT=8000

# Seguridad y Criptografía
# Generar una clave segura para producción (ej: openssl rand -hex 32)
SECRET_KEY=insecure-development-secret-key-change-in-production

# URL canónica pública para el endpoint de inspección en códigos QR
PUBLIC_BASE_URL=http://localhost:8000

# Base de Datos (SQLite para desarrollo local, PostgreSQL para staging/producción)
# Ejemplo SQLite: sqlite:///./instance/deca.sqlite3
# Ejemplo PostgreSQL: postgresql+psycopg2://deca_user:deca_pass@localhost:5432/deca_light
DATABASE_URL=sqlite:///./instance/deca.sqlite3

# Almacenamiento local de ficheros privados (PDFs originales y DeCAs generados)
STORAGE_PATH=./storage

# Configuración de Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Proveedor de correo electrónico (stub, smtp, m365, gmail)
EMAIL_PROVIDER=stub

# Configuración SMTP (solo si EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=portes@tomatesdeautor.com
SMTP_PASSWORD=dummy-smtp-password
SMTP_FROM_EMAIL=portes@tomatesdeautor.com
SMTP_USE_TLS=true
